{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Production (branch main, deployed by CI). The name changes at stage 6 with the domain; until then
  // main keeps serving the LT site and this file on branch europe describes the site to come.
  "name": "atokiausia-lietuva",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Extension-less paths (/, /<region>, /<region>/<unit>) get index.html with status 200.
    "not_found_handling": "single-page-application",
    // The worker runs for page navigations only: it injects the visitor meta tag and logs one view.
    // Static files are answered by the assets layer directly, so they never count as views.
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/vendor/*", "!/data/*", "!/*.*"]
  },
  "analytics_engine_datasets": [
    { "binding": "SITE_VIEWS", "dataset": "poles_views" }
  ],
  "env": {
    // Preview (branch europe). Same worker, its own name and its own analytics dataset.
    "preview": {
      "name": "atokiausia-lietuva-preview",
      "assets": {
        "directory": "./site",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/vendor/*", "!/data/*", "!/*.*"]
      },
      "analytics_engine_datasets": [
        { "binding": "SITE_VIEWS", "dataset": "poles_preview_views" }
      ]
    }
  }
}
