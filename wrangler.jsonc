// Cloudflare Workers + static assets configuration.
// Serves the site/ folder as static assets (same pattern as kongaprojects),
// with one addition: HTML page loads run through worker.js first, which records
// a privacy-clean view count in Workers Analytics Engine and then serves the
// page from the same assets binding. Every other request goes straight to
// assets and never reaches the Worker.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "atokiausia-lietuva",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "analytics_engine_datasets": [
    { "binding": "SITE_VIEWS", "dataset": "atokiausia_views" }
  ]
}
